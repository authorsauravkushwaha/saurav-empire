# SAURAV AI CIVILIZATION — environment template
# Copy to `.env`. NEVER commit `.env`.
# Every value here is optional. The civilization boots with ZERO configuration.

# ---------- Core ----------
EMPIRE_ENV=local                  # local | production
EMPIRE_OWNER=Owner
EMPIRE_CURRENCY=INR
EMPIRE_TIMEZONE=Asia/Kolkata
EMPIRE_DATA_DIR=data/state
EMPIRE_LOG_LEVEL=info
EMPIRE_TICK_SECONDS=1.5           # world simulation tick

# ---------- Local models (Ollama) ----------
# If Ollama is not running the router falls back to the deterministic engine.
# The civilization NEVER pretends a model answered when none did.
EMPIRE_OLLAMA_URL=http://127.0.0.1:11434
EMPIRE_OLLAMA_ENABLED=true
EMPIRE_DEFAULT_MODEL=qwen2.5:0.5b-instruct

# ---------- Optional infrastructure ----------
# EMPIRE_POSTGRES_DSN=postgresql://empire:empire@127.0.0.1:5432/empire
# EMPIRE_REDIS_URL=redis://127.0.0.1:6379/0

# ---------- Internal service auth ----------
# Generated on first boot if absent. Rotate with `python scripts/rotate_keys.py`.
# EMPIRE_INTERNAL_KEY=

# ---------- Owner secrets vault ----------
# Passphrase that unlocks data/state/secrets/vault.enc. Never sent anywhere.
# EMPIRE_VAULT_PASSPHRASE=

# ---------- Integrations (all DISCONNECTED until you fill these in) ----------
# Gmail (official OAuth only — never an app password)
# EMPIRE_GMAIL_CLIENT_ID=
# EMPIRE_GMAIL_CLIENT_SECRET=
# EMPIRE_GMAIL_REFRESH_TOKEN=

# YouTube Data API v3
# EMPIRE_YOUTUBE_API_KEY=

# Instagram Graph API (Business/Creator account required)
# EMPIRE_INSTAGRAM_ACCESS_TOKEN=
# EMPIRE_INSTAGRAM_BUSINESS_ID=

# Facebook Graph API
# EMPIRE_FACEBOOK_PAGE_TOKEN=
# EMPIRE_FACEBOOK_PAGE_ID=

# WhatsApp Cloud API
# EMPIRE_WHATSAPP_TOKEN=
# EMPIRE_WHATSAPP_PHONE_ID=

# Gumroad
# EMPIRE_GUMROAD_ACCESS_TOKEN=
