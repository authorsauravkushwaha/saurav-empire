{
  "name": "civilization-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Saurav AI Civilization \u2014 3D owner console (React + three.js + react-three-fiber)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "smoke": "node scripts/smoke.mjs",
    "verify": "tsc --noEmit && vite build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
